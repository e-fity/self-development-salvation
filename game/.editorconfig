root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# 脚本、场景、数据表统一用 Tab（Godot 默认）
[*.gd]
indent_style = tab
indent_size = 4

[*.tscn]
indent_style = tab
indent_size = 4

[*.tres]
indent_style = tab
indent_size = 4

[*.json]
indent_style = space
indent_size = 2

[*.godot]
indent_style = tab
indent_size = 4

# Markdown 不强制缩进
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
